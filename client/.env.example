# slask-mcp-client — copy to .env and fill in your own values.
# (Already git-ignored by the repo's .gitignore.)

# --- MCP server (all modes) ---------------------------------------------

# Full endpoint for the slask-mcp server (must include /mcp).
# Server defaults: bind 127.0.0.1, port 8000.
SLASK_MCP_URL=http://127.0.0.1:8000/mcp

# Bearer token — only needed when the server runs with
# SLASK_MCP_TOKEN set; otherwise leave blank.
SLASK_MCP_TOKEN=

# JSON config file for *additional* MCP servers (stdio and/or HTTP, any
# number of them). Optional — the default slask server is always included
# unless `--no-default`. Copy client/mcp.example.json to mcp.json in your
# current directory and point this at it, or omit it (the client falls back
# to mcp.json in the current directory).
SLASK_MCP_CONFIG=

# --- OpenAI / model (chat mode only) -------------------------------------

# Base URL of the OpenAI-compatible endpoint.
#   - Real OpenAI:  https://api.openai.com            (needs OPENAI_API_KEY)
#   - Local (e.g. Ollama): http://your-host:11434     (no API key needed)
# The client appends /v1/chat/completions, so don't include it.
API_BASE=https://api.openai.com

# Model to use in the agent. This seeds the *default* entry of models.json in
# the launch directory — when models.json is missing the client creates it from
# MODEL/OPENAI_MODEL (id + name), API_BASE (baseUrl), and
# MAX_CONTEXT_TOKENS (maxContext). Once models.json exists it is authoritative:
# copy client/models.example.json to models.json to manage several named models,
# then select one with --model/-m (the entry's id). For real OpenAI, gpt-4o-mini
# is cheap/fast; for a local server use whatever model name it serves
# (e.g. gemma4:12b-mlx, llama3:8b, …).
# (The legacy name OPENAI_MODEL still works and is checked after MODEL.)
MODEL=gpt-4o-mini

# API key.
#   - Required when pointing at real OpenAI (API_BASE = https://api.openai.com).
#   - Not needed for a local OpenAI-compatible server (the client passes a
#     placeholder key, which such servers ignore).
OPENAI_API_KEY=

# The model's context window in tokens (what your server really allows, e.g.
# the --ctx-size / num_ctx you started it with). Ralph loops size every
# iteration (workers, checkers and the task splitter) to stay inside it:
# tool output is truncated, old output is dropped, tasks are kept small.
# A run's own `contextTokens` setting may only lower it. Default 32000.
MAX_CONTEXT_TOKENS=32000
